{
    "name": "bratCode",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "clean": "turbo run clean",
        "dev": "docker compose up -d && turbo run dev",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "prettier": "^3.6.0",
        "turbo": "^2.10.12"
    },
    "packageManager": "pnpm@8.15.6",
    "engines": {
        "node": ">=18"
    }
}
