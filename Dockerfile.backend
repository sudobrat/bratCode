# We define an argument that we can pass when we run the build command
ARG SERVICE_NAME

# ==========================================
# STAGE 1: PRUNER
# ==========================================
FROM node:22-alpine AS pruner
ARG SERVICE_NAME
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm
WORKDIR /app
RUN npm install -g turbo
COPY . .
# Dynamically prune whatever service we passed!
RUN turbo prune ${SERVICE_NAME} --docker

# ==========================================
# STAGE 2: BUILDER
# ==========================================
FROM node:22-alpine AS builder
ARG SERVICE_NAME
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm
WORKDIR /app

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
# Dynamically build the service
RUN pnpm run build --filter=${SERVICE_NAME}

# ==========================================
# STAGE 3: RUNNER
# ==========================================
FROM node:22-alpine AS runner
ARG SERVICE_NAME
# We need to set it as an ENV so the CMD at the bottom can read it at runtime
ENV RUNNER_SERVICE_NAME=${SERVICE_NAME}

WORKDIR /app
RUN corepack enable pnpm

# Security best practice: don't run node as root
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 expressjs
USER expressjs

COPY --from=builder --chown=expressjs:nodejs /app .

# Start the dynamically passed service!
CMD ["sh", "-c", "pnpm run start --filter=${RUNNER_SERVICE_NAME}"]
