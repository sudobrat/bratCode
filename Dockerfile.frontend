# ==========================================
# STAGE 1: PRUNER
# ==========================================
FROM node:20-alpine AS pruner
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm
WORKDIR /app
RUN npm install -g turbo
COPY . .
# Extract only the frontend and its dependencies
RUN turbo prune frontend --docker

# ==========================================
# STAGE 2: BUILDER
# ==========================================
FROM node:20-alpine AS builder
RUN apk add --no-cache libc6-compat
RUN corepack enable pnpm
WORKDIR /app

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .
# Build the React/Vite app! This creates a 'dist' folder full of static HTML/JS/CSS
RUN pnpm run build --filter=frontend

# ==========================================
# STAGE 3: RUNNER (NGINX)
# ==========================================
# Notice we are NOT using Node.js here! We are using Nginx (a lightning fast web server)
FROM nginx:alpine AS runner

# Remove the default Nginx index.html
RUN rm -rf /usr/share/nginx/html/*

# Copy our compiled React app from the builder stage into Nginx's hosting directory
COPY --from=builder /app/apps/frontend/dist /usr/share/nginx/html

# We also need a custom Nginx config to handle React Router's client-side routing
# We'll create this config file dynamically inside the Dockerfile for simplicity
RUN echo -e 'server {\n\
    listen 80;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html index.htm;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}' > /etc/nginx/conf.d/default.conf

# Expose port 80 and start Nginx
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
